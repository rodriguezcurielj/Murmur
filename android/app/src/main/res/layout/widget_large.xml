<?xml version="1.0" encoding="utf-8"?>
<!-- Big: the cover fills the widget (clipped to the rounded edge), with the song, artist and buttons over its darkened bottom -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/w_art" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:contentDescription="Cover" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_scrim" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
            android:fontFamily="sans-serif-medium" android:shadowColor="#66000000" android:shadowRadius="6" />
        <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp"
            android:textColor="#CCFFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"
            android:shadowColor="#66000000" android:shadowRadius="6" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/w_like" android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/n_heart"
                android:background="@drawable/w_btn_bg" android:scaleType="centerInside" android:padding="9dp" android:contentDescription="Like" />
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/w_prev" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/n_prev"
                android:background="@drawable/w_btn_bg" android:scaleType="centerInside" android:padding="10dp" android:contentDescription="Previous" />
            <ImageButton android:id="@+id/w_play" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
                android:src="@drawable/n_play" android:background="@drawable/w_play_bg" android:tint="#FF121212" android:scaleType="centerInside"
                android:padding="14dp" android:contentDescription="Play" />
            <ImageButton android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/n_next"
                android:background="@drawable/w_btn_bg" android:scaleType="centerInside" android:padding="10dp" android:contentDescription="Next" />
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <FrameLayout android:layout_width="38dp" android:layout_height="1dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
