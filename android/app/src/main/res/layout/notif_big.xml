<?xml version="1.0" encoding="utf-8"?>
<!-- The now-playing card in the notification list, like Spotify's: the cover behind, song and artist,
     a progress bar, and shuffle / previous / play-pause / next / like. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="136dp"
    android:background="@drawable/n_card" android:clipToOutline="true">
    <ImageView android:id="@+id/n_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:importantForAccessibility="no"/>
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/n_scrim" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/n_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/n_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#D9FFFFFF" android:textSize="14sp" android:singleLine="true" android:ellipsize="end"/>
        <ProgressBar android:id="@+id/n_progress" style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="10dp" android:layout_marginEnd="4dp"
            android:progressTint="#FFFFFFFF" android:progressBackgroundTint="#55FFFFFF" android:max="1000"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center">
            <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"><ImageButton android:id="@+id/n_shuffle" android:layout_width="44dp" android:layout_height="44dp" android:background="@null" android:src="@drawable/n_shuffle" android:contentDescription="Shuffle" android:layout_gravity="center"/></FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"><ImageButton android:id="@+id/n_prev" android:layout_width="44dp" android:layout_height="44dp" android:background="@null" android:src="@drawable/n_prev" android:contentDescription="Previous" android:layout_gravity="center"/></FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"><ImageButton android:id="@+id/n_play" android:layout_width="50dp" android:layout_height="50dp" android:background="@null" android:src="@drawable/n_pause" android:contentDescription="Play or pause" android:layout_gravity="center" android:scaleType="fitCenter" android:padding="4dp"/></FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"><ImageButton android:id="@+id/n_next" android:layout_width="44dp" android:layout_height="44dp" android:background="@null" android:src="@drawable/n_next" android:contentDescription="Next" android:layout_gravity="center"/></FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"><ImageButton android:id="@+id/n_like" android:layout_width="44dp" android:layout_height="44dp" android:background="@null" android:src="@drawable/n_heart" android:contentDescription="Like" android:layout_gravity="center"/></FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
