<?xml version="1.0" encoding="utf-8"?>
<!-- One row: rounded cover, song and artist, previous / play / next -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/w_bg"
    android:clipToOutline="true" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <ImageView android:id="@+id/w_art" android:layout_width="54dp" android:layout_height="54dp"
        android:scaleType="centerCrop" android:contentDescription="Cover" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="6dp">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
            android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp"
            android:textColor="#B3FFFFFF" android:textSize="12.5sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageButton android:id="@+id/w_prev" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/n_prev"
        android:background="@drawable/w_btn_bg" android:scaleType="centerInside" android:padding="9dp" android:contentDescription="Previous" />
    <ImageButton android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
        android:src="@drawable/n_play" android:background="@drawable/w_play_bg" android:tint="#FF121212" android:scaleType="centerInside"
        android:padding="12dp" android:contentDescription="Play" />
    <ImageButton android:id="@+id/w_next" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/n_next"
        android:background="@drawable/w_btn_bg" android:scaleType="centerInside" android:padding="9dp" android:contentDescription="Next" />
</LinearLayout>
