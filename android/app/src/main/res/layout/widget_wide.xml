<?xml version="1.0" encoding="utf-8"?>
<!-- One row: cover, song and artist, previous / play / next -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/w_bg" android:padding="8dp">
    <ImageView android:id="@+id/w_art" android:layout_width="52dp" android:layout_height="52dp"
        android:scaleType="centerCrop" android:contentDescription="Cover" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFB3B3B3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageButton android:id="@+id/w_prev" android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/n_prev"
        android:background="@android:color/transparent" android:scaleType="centerInside" android:padding="8dp" android:contentDescription="Previous" />
    <ImageButton android:id="@+id/w_play" android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/n_play"
        android:background="@drawable/w_play_bg" android:tint="#FF121212" android:scaleType="centerInside" android:padding="10dp" android:contentDescription="Play" />
    <ImageButton android:id="@+id/w_next" android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/n_next"
        android:background="@android:color/transparent" android:scaleType="centerInside" android:padding="8dp" android:contentDescription="Next" />
</LinearLayout>
