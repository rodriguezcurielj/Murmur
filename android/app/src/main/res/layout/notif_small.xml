<?xml version="1.0" encoding="utf-8"?>
<!-- The same card folded: song, artist, previous / play-pause / next. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="64dp"
    android:background="@drawable/n_card" android:clipToOutline="true">
    <ImageView android:id="@+id/n_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:importantForAccessibility="no"/>
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/n_scrim" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/n_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/n_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#D9FFFFFF" android:textSize="13sp" android:singleLine="true" android:ellipsize="end"/>
        </LinearLayout>
        <ImageButton android:id="@+id/n_prev" android:layout_width="40dp" android:layout_height="40dp" android:background="@null" android:src="@drawable/n_prev" android:contentDescription="Previous"/>
        <ImageButton android:id="@+id/n_play" android:layout_width="44dp" android:layout_height="44dp" android:background="@null" android:src="@drawable/n_pause" android:contentDescription="Play or pause" android:scaleType="fitCenter" android:padding="4dp"/>
        <ImageButton android:id="@+id/n_next" android:layout_width="40dp" android:layout_height="40dp" android:background="@null" android:src="@drawable/n_next" android:contentDescription="Next"/>
    </LinearLayout>
</FrameLayout>
