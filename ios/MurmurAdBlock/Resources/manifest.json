{
  "manifest_version": 3,
  "name": "Murmur Ad Blocker",
  "version": "1.0",
  "description": "Removes ads from YouTube songs played in Murmur. It only acts on YouTube players inside Murmur.",
  "icons": { "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube-nocookie.com/embed/*", "https://www.youtube.com/embed/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://rodriguezcurielj.github.io/Murmur/*",
        "https://*.ts.net/*",
        "https://*.trycloudflare.com/*"
      ],
      "js": ["murmur-flag.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["youtube-strip.js"], "matches": ["https://www.youtube-nocookie.com/*", "https://www.youtube.com/*"] }
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "ads", "enabled": true, "path": "rules.json" }]
  },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["https://www.youtube-nocookie.com/*", "https://www.youtube.com/*", "*://*.doubleclick.net/*", "*://*.googlesyndication.com/*"]
}
