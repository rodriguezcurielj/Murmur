{
  "name": "murmur-desktop",
  "productName": "Murmur",
  "version": "1.1.0",
  "description": "Murmur for Windows",
  "main": "main.js",
  "author": "Murmur",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.murmur.desktop",
    "productName": "Murmur",
    "artifactName": "Murmur-Setup.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Murmur",
      "runAfterFinish": true
    }
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}
